<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
        <field name="view_mode">list,form,kanban,pivot,graph,calendar</field>
    </record>

    <record id="hr_timesheet_line_calendar" model="ir.ui.view">
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="hr_timesheet.view_calendar_account_analytic_line"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="date_start">date_time</attribute>
                <attribute name="date_stop">date_time_end</attribute>
                <attribute name="scales">day,week,month</attribute>
                <attribute name="mode">week</attribute>
                <attribute name="color">project_id</attribute>
                <attribute name="event_open_popup">1</attribute>
                <attribute name="quick_create">1</attribute>
            </calendar>
            <field name="project_id" position="attributes">
                <attribute name="filters">1</attribute>
            </field>
            <field name="project_id" position="after">
                <field name="partner_id" filters="1" />
            </field>
        </field>
    </record>

    <!-- In Odoo 19.0, hr_timesheet already registers a calendar action view for
         act_hr_timesheet_line. We update that existing record to use our custom
         calendar view instead of inserting a duplicate (which would violate the
         ir_act_window_view_unique_mode_per_action constraint). -->
    <record
        id="hr_timesheet.act_hr_timesheet_line_view_calendar"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="4" />
        <field name="view_id" ref="hr_timesheet_line_calendar" />
    </record>

    <record id="hr_timesheet_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form.inherit</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="product_uom_id" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
